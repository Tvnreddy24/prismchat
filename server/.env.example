# ---- Prism RAG Server (.env) ----
# Copy this file to `.env` and fill the values.
# `cp .env.example .env`  (PowerShell: Copy-Item .env.example .env)

# Postgres with pgvector. Two easy options:
#  1) Supabase (recommended, free): Database > Connect > Transaction pooler URI
#     Example: postgresql://postgres.xxx:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
#  2) Local docker: docker run -d -p 5432:5432 -e POSTGRES_PASSWORD=postgres pgvector/pgvector:pg16
#     Then: postgresql://postgres:postgres@localhost:5432/postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

# Same Gemini key you use in the Prism Chat frontend (Google AI Studio).
# Used ONLY on the server for embeddings. Never expose this to the browser.
GEMINI_API_KEY=

# Optional — for web fallback when dept data has no answer.
# Get one free key from https://tavily.com  (500 searches/month free)
# If empty, server skips web search and tells frontend "dept data not found".
TAVILY_API_KEY=
# Optional second choice if you prefer Serper: https://serper.dev
SERPER_API_KEY=

# Server port
PORT=8787

# ---- ADMIN (dept data feeding — ONLY admin can upload/delete) ----
# Credentials live ONLY here in server/.env (gitignored, never in code).
# 1) Pick a username:
ADMIN_USERNAME=admin
# 2) Generate a bcrypt hash for your password (plaintext NEVER goes in any file):
#      cd server; npm install; $env:APW='YourStrongPassword'; node -e "import('bcryptjs').then(async (m)=>{console.log(await m.hash(process.env.APW,10))})"
#    Paste the $2b$10$... output below:
ADMIN_PASSWORD_HASH=
# 3) Random signing secret (generate: node -e "import('node:crypto').then((c)=>console.log(c.randomBytes(32).toString('hex')))")
JWT_SECRET=

# ---- APP ACCESS (permission: only staff YOU share the code with can chat) ----
# Set this to REQUIRE an access code before the chat UI opens. Backend enforces
# it on /api/query, /api/chat-context, /api/temp-extract (admin token also works).
# Generate exactly like the admin password above (bcrypt hash, plaintext nowhere):
# APP_ACCESS_PASSWORD_HASH=$2b$10$...
# Empty/missing = open access (anyone with the link can chat).
APP_ACCESS_PASSWORD_HASH=

# Comma-separated origins allowed to call this API (your frontend URL).
# Vite dev default is http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# Retrieval tuning
RAG_TOP_K=5
RAG_MIN_SCORE=0.32
RAG_MAX_CONTEXT_CHARS=12000

# Optional: force an embedding model (default = auto-detect per key, 768 dims).
# EMBEDDING_MODEL=gemini-embedding-001
